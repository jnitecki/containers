FROM ubuntu:24.04
# No version defaults: the build scripts pass every ARG below from settings.ps1 (Versions).
# AGENT_VERSION is required; it is checked in the first RUN so a missing value fails fast.
ARG AGENT_VERSION

# --- Feature toggles (pass via --build-arg; empty or unset = feature not installed) ---
ARG INSTALL_PODMAN
ARG INSTALL_BUILD_ESSENTIAL
# INSTALL_PYTHON_DEV requires INSTALL_BUILD_ESSENTIAL=true (native extension builds need gcc).
ARG INSTALL_PYTHON_DEV
ARG INSTALL_JAVA
# INSTALL_ANDROID carries the Android build-tools version to install, e.g. 34.0.0; its major component is used as the platform (API) version. Requires INSTALL_JAVA to be set.
ARG INSTALL_ANDROID
# cmdline-tools build number from https://developer.android.com/studio#command-tools; required when INSTALL_ANDROID is set.
ARG ANDROID_CMDLINE_TOOLS_VERSION
# INSTALL_ANDROID_EMULATOR: an Android API level (e.g. 36) installs the emulator plus that level's default
# x86_64 system image; "true" installs the emulator only. Requires INSTALL_ANDROID to be set. Ignored on
# arm64: no Android emulator is published for Linux arm64 hosts.
ARG INSTALL_ANDROID_EMULATOR
ARG INSTALL_POWERSHELL
ARG INSTALL_DOTNET
ARG INSTALL_NODE

RUN [ -n "$AGENT_VERSION" ] || { echo "error: AGENT_VERSION build arg is required" >&2; exit 1; } && \
    apt-get update && apt-get install -y \
    ca-certificates curl jq git pipx iputils-ping libicu-dev tar unzip \
    && rm -rf /var/lib/apt/lists/*

# --- Podman support (optional, nested containers) ---
# PODMAN (path to podman) is kept by entrypoint.sh only if the container runs --privileged.
RUN if [ "$INSTALL_PODMAN" = "true" ]; then \
      apt-get update && apt-get install -y \
        podman fuse-overlayfs uidmap slirp4netns iptables \
      && update-alternatives --set iptables /usr/sbin/iptables-legacy \
      && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy \
      && mkdir -p /etc/containers \
      && printf '[storage]\ndriver = "overlay"\nrunroot = "/run/containers/storage"\ngraphroot = "/var/lib/containers/storage"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
        > /etc/containers/storage.conf \
      && printf '[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' \
        > /etc/containers/containers.conf \
      && rm -rf /var/lib/apt/lists/*; \
    fi
ENV PODMAN=${INSTALL_PODMAN:+/usr/bin/podman}
# --- end Podman support ---

# --- Build essentials (optional, native C/C++ toolchain: gcc, g++, make, libc dev headers) ---
RUN if [ "$INSTALL_BUILD_ESSENTIAL" = "true" ]; then \
      apt-get update && apt-get install -y build-essential \
      && rm -rf /var/lib/apt/lists/*; \
    fi
# --- end Build essentials ---

# --- Python development headers (optional, requires INSTALL_BUILD_ESSENTIAL=true) ---
# Ubuntu 24.04 has no python-dev package; python3-dev provides Python.h and python3-config
# for building native extension modules.
RUN if [ "$INSTALL_PYTHON_DEV" = "true" ]; then \
      if [ "$INSTALL_BUILD_ESSENTIAL" != "true" ]; then \
        echo "error: INSTALL_PYTHON_DEV=true requires INSTALL_BUILD_ESSENTIAL=true" >&2; exit 1; \
      fi && \
      apt-get update && apt-get install -y python3-dev \
      && rm -rf /var/lib/apt/lists/*; \
    fi
# --- end Python development headers ---

# --- Java SDK (optional) ---
# Ubuntu 24.04's openjdk packages don't create /usr/lib/jvm/default-java, so we
# create it ourselves (architecture-aware) for a stable JAVA_HOME below.
RUN if [ -n "$INSTALL_JAVA" ]; then \
      apt-get update && apt-get install -y "openjdk-${INSTALL_JAVA}-jdk" \
      && ln -sfn "/usr/lib/jvm/java-${INSTALL_JAVA}-openjdk-$(dpkg --print-architecture)" /usr/lib/jvm/default-java \
      && rm -rf /var/lib/apt/lists/*; \
    fi
ENV JAVA_HOME=${INSTALL_JAVA:+/usr/lib/jvm/default-java}
ENV PATH="${JAVA_HOME:+${JAVA_HOME}/bin:}${PATH}"
ENV JAVA_HOME_${INSTALL_JAVA}=${INSTALL_JAVA:+/usr/lib/jvm/default-java}
# --- end Java SDK ---

# --- Android SDK (optional, requires INSTALL_JAVA to be set) ---
ENV ANDROID_HOME=${INSTALL_ANDROID:+/opt/android-sdk}
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV PATH="${ANDROID_HOME:+${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:}${PATH}"
ENV ANDROID_HOME_${INSTALL_ANDROID%%.*}=${INSTALL_ANDROID:+/opt/android-sdk}

RUN if [ -n "$INSTALL_ANDROID" ]; then \
      if [ -z "$ANDROID_CMDLINE_TOOLS_VERSION" ]; then \
        echo "error: ANDROID_CMDLINE_TOOLS_VERSION build arg is required when INSTALL_ANDROID is set" >&2; exit 1; \
      fi && \
      ANDROID_PLATFORM_MAJOR="${INSTALL_ANDROID%%.*}" && \
      ANDROID_PLATFORM_MAJOR_MINOR="${INSTALL_ANDROID%.*}" && \
      mkdir -p "${ANDROID_HOME}/cmdline-tools" && \
      curl -LsS -o /tmp/cmdline-tools.zip \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" && \
      unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools" && \
      mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" && \
      rm /tmp/cmdline-tools.zip && \
      SDKMANAGER="${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" && \
      yes | "$SDKMANAGER" --licenses > /dev/null && \
      "$SDKMANAGER" \
        "platform-tools" \
        "build-tools;${INSTALL_ANDROID}" > /dev/null && \
      install_android_platform() { \
        "$SDKMANAGER" "platforms;android-$1" > /dev/null 2>&1; \
        [ -d "${ANDROID_HOME}/platforms/android-$1" ]; \
      } && \
      ( install_android_platform "$ANDROID_PLATFORM_MAJOR" \
        || install_android_platform "$ANDROID_PLATFORM_MAJOR_MINOR" \
        || { echo "error: could not install an Android platform package for INSTALL_ANDROID=${INSTALL_ANDROID} (tried platforms;android-${ANDROID_PLATFORM_MAJOR} and platforms;android-${ANDROID_PLATFORM_MAJOR_MINOR})" >&2; exit 1; } ); \
    fi
# --- end Android SDK ---

# --- Android emulator (optional, requires INSTALL_ANDROID to be set) ---
# Only installed here; entrypoint.sh reports it as a capability only if hardware acceleration
# (-accel-check, i.e. a usable /dev/kvm) is available at container start.
RUN if [ -n "$INSTALL_ANDROID_EMULATOR" ]; then \
      if [ -z "$INSTALL_ANDROID" ]; then \
        echo "error: INSTALL_ANDROID_EMULATOR requires INSTALL_ANDROID to be set" >&2; exit 1; \
      fi && \
      case "$INSTALL_ANDROID_EMULATOR" in \
        true|*[!0-9]*) ;; \
        *) EMULATOR_API="$INSTALL_ANDROID_EMULATOR" ;; \
      esac && \
      if [ "$INSTALL_ANDROID_EMULATOR" != "true" ] && [ -z "$EMULATOR_API" ]; then \
        echo "error: INSTALL_ANDROID_EMULATOR must be 'true' or an Android API level, got '${INSTALL_ANDROID_EMULATOR}'" >&2; exit 1; \
      fi && \
      case "$(uname -m)" in \
        x86_64) EMULATOR_ABI=x86_64 ;; \
        aarch64) echo "warning: no Android emulator is published for Linux arm64, ignoring INSTALL_ANDROID_EMULATOR=${INSTALL_ANDROID_EMULATOR}" >&2 && exit 0 ;; \
        *) echo "unsupported arch $(uname -m)" && exit 1 ;; \
      esac && \
      EMULATOR_SYSTEM_IMAGE="${EMULATOR_API:+system-images;android-${EMULATOR_API};default;${EMULATOR_ABI}}" && \
      yes | "${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" --install \
        "emulator" ${EMULATOR_SYSTEM_IMAGE:+"$EMULATOR_SYSTEM_IMAGE"} > /dev/null && \
      if [ ! -x "${ANDROID_HOME}/emulator/emulator" ]; then \
        echo "error: could not install the Android emulator package" >&2; exit 1; \
      fi && \
      if [ -n "$EMULATOR_SYSTEM_IMAGE" ] \
         && [ ! -d "${ANDROID_HOME}/system-images/android-${INSTALL_ANDROID_EMULATOR}/default/${EMULATOR_ABI}" ]; then \
        echo "error: could not install ${EMULATOR_SYSTEM_IMAGE}" >&2; exit 1; \
      fi; \
    fi
# --- end Android emulator ---

# --- PowerShell Core (optional) ---
RUN if [ -n "$INSTALL_POWERSHELL" ]; then \
      case "$(uname -m)" in \
        x86_64) PS_ARCH=x64 ;; \
        aarch64) PS_ARCH=arm64 ;; \
        *) echo "unsupported arch $(uname -m)" && exit 1 ;; \
      esac && \
      PS_MAJOR_VERSION="${INSTALL_POWERSHELL%%.*}" && \
      curl -LsS -o /tmp/powershell.tar.gz \
        "https://github.com/PowerShell/PowerShell/releases/download/v${INSTALL_POWERSHELL}/powershell-${INSTALL_POWERSHELL}-linux-${PS_ARCH}.tar.gz" && \
      mkdir -p "/opt/microsoft/powershell/${PS_MAJOR_VERSION}" && \
      tar -xzf /tmp/powershell.tar.gz -C "/opt/microsoft/powershell/${PS_MAJOR_VERSION}" && \
      chmod +x "/opt/microsoft/powershell/${PS_MAJOR_VERSION}/pwsh" && \
      ln -sf "/opt/microsoft/powershell/${PS_MAJOR_VERSION}/pwsh" /usr/bin/pwsh && \
      rm /tmp/powershell.tar.gz; \
    fi
ENV pwsh=${INSTALL_POWERSHELL:+/usr/bin/pwsh}
ENV PowerShell=${INSTALL_POWERSHELL:+/usr/bin/pwsh}
ENV PWSH_${INSTALL_POWERSHELL%%.*}=${INSTALL_POWERSHELL:+/usr/bin/pwsh}
# --- end PowerShell Core ---

# --- .NET SDK (optional) ---
RUN if [ -n "$INSTALL_DOTNET" ]; then \
      curl -LsS https://dot.net/v1/dotnet-install.sh | bash -s -- --channel "$INSTALL_DOTNET" --install-dir /opt/dotnet; \
    fi
ENV DOTNET_ROOT=${INSTALL_DOTNET:+/opt/dotnet}
ENV PATH="${DOTNET_ROOT:+${DOTNET_ROOT}:}${PATH}"
ENV DOTNET_NOLOGO=${INSTALL_DOTNET:+1}
ENV DOTNET_CLI_TELEMETRY_OPTOUT=${INSTALL_DOTNET:+1}
# --- end .NET SDK ---

# --- Node.js (optional) ---
# NodeSource's setup script is only published per major version (setup_<major>.x); it installs
# whatever the latest nodejs package is for that major in NodeSource's apt repo, so INSTALL_NODE's
# minor/patch components aren't pinned exactly by this install method.
RUN if [ -n "$INSTALL_NODE" ]; then \
      NODE_MAJOR="${INSTALL_NODE%%.*}" && \
      curl -LsS "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - && \
      apt-get install -y nodejs \
      && rm -rf /var/lib/apt/lists/*; \
    fi
# --- end Node.js ---

WORKDIR /azp/agent

RUN case "$(uname -m)" in \
      x86_64) AZP_ARCH=x64 ;; \
      aarch64) AZP_ARCH=arm64 ;; \
      *) echo "unsupported arch $(uname -m)" && exit 1 ;; \
    esac && \
    curl -LsS -o agent.tar.gz \
      "https://download.agent.dev.azure.com/agent/${AGENT_VERSION}/vsts-agent-linux-${AZP_ARCH}-${AGENT_VERSION}.tar.gz" && \
    tar -xzf agent.tar.gz && \
    rm agent.tar.gz && \
    apt-get update && \
    ./bin/installdependencies.sh && \
    rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /azp/entrypoint.sh
RUN chmod +x /azp/entrypoint.sh

ENTRYPOINT ["/azp/entrypoint.sh"]
